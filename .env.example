# ─────────────────────────────────────────────────────────────────────────────
# WedSaaS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://wedsaas_user:STRONG_PASSWORD@localhost:5432/wedsaas_db

# ── Session ───────────────────────────────────────────────────────────────────
# Secret key for signing session cookies (required, generate with: openssl rand -hex 64)
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING

# ── App ───────────────────────────────────────────────────────────────────────
# Canonical URL of your app (used in SEO, links, etc.)
APP_URL=https://yourdomain.com

# Node environment (set to "production" for VPS/server)
NODE_ENV=production

# Port to listen on (default: 5000)
PORT=5000

# ── Admin Account (used by db:seed on first run) ──────────────────────────────
# These are only read during seeding. Change them before running npm run db:seed.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Site Customization (optional, used by db:seed) ───────────────────────────
SITE_NAME=WedSaaS

# ── Demo Data (optional) ──────────────────────────────────────────────────────
# Set to "true" to skip seeding the demo user and sample invitation
SKIP_DEMO_SEED=false
